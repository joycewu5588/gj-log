<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<!-- 不讓搜尋引擎收錄這個頁面 -->
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
<meta name="googlebot" content="noindex, nofollow">
<!-- 加入主畫面後的 App 設定 -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="水上日誌">
<meta name="theme-color" content="#1e5a8a">
<link rel="apple-touch-icon" href="data:image/jpeg;base64,">
<link rel="icon" href="data:image/jpeg;base64,">
<title>水 上 日 誌</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  :root {
    --bg1: #f5f1ea; --bg2: #ede6da; --ink: #1c1917; --ink2: #44403c;
    --stone: #78716c; --stone-l: #a8a29e; --line: rgba(139,111,74,0.18);
    --seal: #1e5a8a; --gold: #8b6f4a; --paper: #fdfbf7;
    --win: #15803d; --lose: #be123c; --win-d: #6ee7b7; --lose-d: #fca5a5;
  }
  html, body { background: linear-gradient(180deg, var(--bg1) 0%, var(--bg2) 100%); min-height: 100vh; }
  body { font-family: "Noto Serif TC", "Songti SC", serif; padding-bottom: 48px; color: var(--ink); }
  .num { font-family: 'JetBrains Mono', monospace; }
  .display { font-family: 'Cormorant Garamond', serif; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 40px 18px 0; }
  .card-sh { box-shadow: 0 1px 2px rgba(60,40,20,0.04), 0 8px 24px rgba(60,40,20,0.06); }
  .ink-div { background: linear-gradient(90deg, transparent, var(--gold) 20%, var(--gold) 80%, transparent); height: 1px; }
  .seal { background: var(--seal); color: var(--bg1); font-weight: 700; letter-spacing: 0.15em;
          display: inline-flex; align-items: center; padding: 3px 11px; border-radius: 2px; font-size: 11px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.15em; color: var(--stone); text-transform: uppercase; }

  /* header */
  .h-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  h1.title { font-family: 'Cormorant Garamond', serif; font-size: clamp(44px, 9vw, 68px);
             font-weight: 300; margin-top: 14px; line-height: 1.1; }
  .subtitle { color: var(--stone); margin-top: 10px; letter-spacing: 0.08em; font-size: 13px; }

  /* tools */
  .tools { display: flex; gap: 9px; margin-top: 18px; flex-wrap: wrap; }
  .btn-sm { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 8px;
            border: 1px solid #d4c5a9; background: rgba(255,255,255,0.7); color: var(--ink2);
            cursor: pointer; font-family: inherit; font-size: 13px; transition: all 0.15s; }
  .btn-sm:active { background: #fff; transform: scale(0.97); }
  .btn-sm svg { width: 14px; height: 14px; }

  .btn-add-inline { width: 100%; margin-top: 14px; background: var(--ink); color: var(--bg1);
      padding: 14px; border-radius: 12px; font-weight: 500; letter-spacing: 0.1em; border: none;
      cursor: pointer; font-family: inherit; font-size: 15px; display: flex; align-items: center;
      justify-content: center; gap: 8px; }
  .btn-add-inline:active { opacity: 0.85; }
  .note { background: rgba(139,111,74,0.1); border: 1px solid rgba(139,111,74,0.25);
          border-radius: 10px; padding: 11px 15px; font-size: 12px; color: var(--stone);
          line-height: 1.7; margin-top: 14px; }
  .note b { color: var(--ink2); }

  /* summary */
  .cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-top: 26px; }
  .scard { border-radius: 16px; padding: 16px; }
  .scard .lbl { font-family:'Cormorant Garamond',serif; font-size: 19px; }
  .scard .sub { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; margin-top: 2px; }
  .scard .amt { font-size: clamp(20px, 5.5vw, 28px); font-weight: 300; letter-spacing: -0.02em; margin-top: 12px; display: block; }
  .scard .cnt { font-size: 11px; margin-top: 7px; }

  /* chart */
  .panel { margin-top: 26px; background: rgba(255,255,255,0.6); border-radius: 18px; padding: 18px; }
  .panel-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
  .panel-head h2 { font-family:'Cormorant Garamond',serif; font-size: 20px; font-weight: 500; }
  #chart { width: 100%; height: 220px; }

  /* records */
  .rec-head { display: flex; align-items: baseline; justify-content: space-between; margin: 26px 2px 12px; }
  .rec-head h2 { font-family:'Cormorant Garamond',serif; font-size: 20px; font-weight: 500; }
  .sess { background: rgba(255,255,255,0.6); border: 1px solid var(--line); border-radius: 14px;
          padding: 13px 16px; margin-bottom: 8px; }
  .sess-top { display: flex; align-items: center; justify-content: space-between;
              padding-bottom: 9px; border-bottom: 1px solid rgba(139,111,74,0.15); margin-bottom: 7px; }
  .sess-date { font-size: 14px; color: var(--ink2); font-weight: 500; }
  .sess-venue { font-size: 13px; color: var(--stone); margin-left: 9px; }
  .sess-sum-lbl { font-size: 10px; letter-spacing: 0.12em; color: var(--stone-l); }
  .sess-sum { font-size: 14px; font-weight: 700; margin-left: 6px; }
  .prow { display: flex; align-items: center; justify-content: space-between; padding: 5px 0; }
  .prow .name { font-size: 13px; color: var(--ink2); }
  .prow .val { font-size: 15px; font-weight: 600; }
  .prow .none { font-size: 12px; color: #d6d3d1; }
  .dbtn { background: none; border: none; cursor: pointer; padding: 4px; margin-left: 6px;
          color: var(--stone-l); display: inline-flex; }
  .empty { text-align: center; color: var(--stone-l); padding: 40px 0; font-size: 14px; }

  /* modal */
  .overlay { position: fixed; inset: 0; z-index: 50; display: none; align-items: flex-end;
             justify-content: center; padding: 14px; background: rgba(28,25,23,0.5); backdrop-filter: blur(6px); }
  .overlay.show { display: flex; }
  .modal { background: var(--paper); border-radius: 22px 22px 18px 18px; max-width: 440px; width: 100%;
           padding: 24px; box-shadow: 0 8px 40px rgba(0,0,0,0.25);
           animation: slideUp 0.28s cubic-bezier(0.16,1,0.3,1); max-height: 90vh; overflow-y: auto; }
  @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .modal h2 { font-family:'Cormorant Garamond',serif; font-size: 28px; font-weight: 400; margin: 10px 0 4px; }
  .modal .tag { color: var(--stone); font-size: 12px; letter-spacing: 0.08em; margin-bottom: 18px; }
  .field { margin-bottom: 14px; }
  .field > label { display: block; font-size: 11px; letter-spacing: 0.15em; color: var(--stone);
                   text-transform: uppercase; margin-bottom: 7px; }
  .ifield { background: #fdfbf7; border: 1px solid #d4c5a9; padding: 11px 12px; border-radius: 8px;
            font-family: inherit; font-size: 16px; color: var(--ink); width: 100%; }
  .ifield:focus { outline: none; border-color: var(--gold); }
  .venues { display: flex; flex-wrap: wrap; gap: 7px; }
  .venues .vbtn { flex: 0 0 auto; padding: 8px 14px; }
  .venue-empty { font-size: 12px; color: var(--stone-l); padding: 2px 0 4px; }
  .vbtn { padding: 9px 4px; border-radius: 8px; font-size: 14px; cursor: pointer; font-family: inherit;
          background: var(--bg1); color: #5a4530; border: 1px solid #d4c5a9; transition: all 0.12s; }
  .vbtn.on { background: var(--ink); color: var(--bg1); border-color: var(--ink); }
  .wl { display: flex; gap: 6px; }
  .wlbtn { flex: 1; padding: 8px 0; border-radius: 7px; font-size: 14px; font-family: inherit;
           cursor: pointer; border: 1px solid #d4c5a9; background: var(--bg1); color: #5a4530; }
  .wlbtn.win.on { background: var(--win); color: #fff; border-color: var(--win); }
  .wlbtn.lose.on { background: var(--lose); color: #fff; border-color: var(--lose); }
  .year-tabs { display: flex; gap: 8px; margin-top: 18px; flex-wrap: wrap; }
  .ytab { padding: 6px 16px; border-radius: 20px; font-size: 14px; font-family: inherit;
          cursor: pointer; border: 1px solid #b8cfe0; background: rgba(255,255,255,0.6);
          color: #2c5a7a; transition: all 0.15s; }
  .ytab.on { background: #1e5a8a; color: #fff; border-color: #1e5a8a; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .hint { font-size: 11px; color: var(--stone-l); margin-top: 2px; }
  .actions { display: flex; gap: 10px; margin-top: 20px; }
  .btn-g { flex: 1; background: transparent; color: #5a4530; padding: 12px; border-radius: 8px;
           border: 1px solid #d4c5a9; font-weight: 500; cursor: pointer; font-family: inherit; font-size: 15px; }
  .btn-p { flex: 1; background: var(--ink); color: var(--bg1); padding: 12px; border-radius: 8px;
           font-weight: 500; letter-spacing: 0.08em; border: none; cursor: pointer; font-family: inherit; font-size: 15px; }
  .btn-p:active, .btn-g:active { transform: scale(0.98); }

  /* toast */
  .toast { position: fixed; bottom: 24px; right: 20px; background: var(--ink); color: #f5f0e8;
           padding: 11px 16px; border-radius: 10px; font-size: 13px; display: none; align-items: center;
           gap: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); z-index: 60; max-width: 260px; }
  .toast.show { display: flex; animation: tIn 0.25s ease-out; }
  @keyframes tIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  .fu { opacity: 0; animation: fu 0.4s ease-out forwards; }
  @keyframes fu { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>
<div class="wrap">
  <div class="fu" style="animation-delay:.05s">
    <div class="h-top">
      <span class="seal">日誌</span>
      <span class="eyebrow" id="appdate"></span>
    </div>
    <h1 class="title">水 上 日 誌</h1>
    <p class="subtitle" id="subtitle">A record of fortune &amp; misfortune</p>

    <div id="yearTabs" class="year-tabs"></div>

    <div class="tools">
      <button class="btn-sm" onclick="exportData()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        備份
      </button>
      <button class="btn-sm" onclick="document.getElementById('imp').click()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        還原備份
      </button>
      <input id="imp" type="file" accept=".json" style="display:none" onchange="importData(event)">
      <button class="btn-sm" onclick="editNames()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        改名字
      </button>
    </div>

    <button class="btn-add-inline" onclick="openForm()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      新 增 記 錄
    </button>

    <div class="note">
      💡 資料只存在你自己的手機裡，別人看不到，你也看不到別人的。換手機或想多一層保險時，按「<b>備份</b>」存一份檔案；需要時用「<b>還原備份</b>」載回來。
    </div>

    <div class="ink-div" style="margin-top:22px"></div>
  </div>

  <div class="cards" id="cards"></div>

  <div class="panel fu" style="animation-delay:.3s" id="chartPanel">
    <div class="panel-head">
      <h2>累 計 走 勢</h2><span class="eyebrow">Cumulative</span>
    </div>
    <svg id="chart"></svg>
  </div>

  <div class="fu" style="animation-delay:.4s">
    <div class="rec-head">
      <h2>逐 場 明 細</h2><span class="eyebrow" id="sessCount"></span>
    </div>
    <div id="records"></div>
  </div>
</div>


<div class="toast" id="toast"></div>

<!-- 表單 -->

<!-- 首次使用：設定名稱 -->
<div class="overlay" id="setupOverlay">
  <div class="modal">
    <div class="h-top">
      <span class="seal">歡迎</span><span class="eyebrow">Setup</span>
    </div>
    <h2>先設定名字</h2>
    <p class="tag">這個記錄本給兩個人使用，資料只會存在你自己的手機裡。</p>
    <div class="field">
      <label>第一位</label>
      <input type="text" class="ifield" id="setA" placeholder="例如：小明" maxlength="10">
    </div>
    <div class="field">
      <label>第二位</label>
      <input type="text" class="ifield" id="setB" placeholder="例如：小華" maxlength="10">
    </div>
    <div class="actions">
      <button class="btn-p" style="flex:1" onclick="doSetup()">開 始 記 錄</button>
    </div>
  </div>
</div>

<div class="overlay" id="overlay" onclick="if(event.target===this)closeForm()">
  <div class="modal">
    <div class="h-top">
      <span class="seal">新增</span><span class="eyebrow">New Entry</span>
    </div>
    <h2>記 一 筆</h2>
    <p class="tag">輸贏只是過程，記得才是日子。</p>

    <div class="field">
      <label>日 期</label>
      <input type="date" class="ifield num" id="fDate">
    </div>
    <div class="field">
      <label>地 點（可留空）</label>
      <div class="venues" id="venues"></div>
      <input type="text" class="ifield" id="fCustom" placeholder="輸入地點，例如：家裡" maxlength="20" style="margin-top:8px">
    </div>
    <div class="two">
      <div class="field" style="margin-bottom:0">
        <label id="lblA">玩家一</label>
        <div class="wl" id="wlA">
          <button type="button" class="wlbtn win on" onclick="setWL('A','win')">贏</button>
          <button type="button" class="wlbtn lose" onclick="setWL('A','lose')">輸</button>
        </div>
        <input type="number" inputmode="decimal" class="ifield num" id="fGary" placeholder="金額" style="margin-top:7px">
      </div>
      <div class="field" style="margin-bottom:0">
        <label id="lblB">玩家二</label>
        <div class="wl" id="wlB">
          <button type="button" class="wlbtn win on" onclick="setWL('B','win')">贏</button>
          <button type="button" class="wlbtn lose" onclick="setWL('B','lose')">輸</button>
        </div>
        <input type="number" inputmode="decimal" class="ifield num" id="fJoyce" placeholder="金額" style="margin-top:7px">
      </div>
    </div>
    <p class="hint" style="margin-top:10px">先選「贏」或「輸」，再打金額（不用打正負號）。沒打的人留空即可。</p>

    <div class="actions">
      <button class="btn-g" onclick="closeForm()">取 消</button>
      <button class="btn-p" onclick="addRecord()">確 認 入 帳</button>
    </div>
  </div>
</div>

<script>
// 全域錯誤捕捉：把真正的錯誤顯示在畫面最上方，方便除錯
window.onerror = function(msg, src, line, col, err) {
  // 忽略跨來源資源（如字型）造成的無意義 "Script error." 第0行假警報
  if ((!line && !col) || msg === 'Script error.') return false;
  var box = document.getElementById('errbox');
  if (!box) {
    box = document.createElement('div');
    box.id = 'errbox';
    box.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;background:#a0392c;color:#fff;padding:10px 14px;font-size:12px;font-family:monospace;line-height:1.5;white-space:pre-wrap;word-break:break-all;';
    document.body.appendChild(box);
  }
  box.textContent = '錯誤：' + msg + '\n位置：第 ' + line + ' 行 第 ' + col + ' 列' + (err && err.stack ? '\n' + err.stack : '');
  return false;
};
const STORAGE_KEY = 'water_log_shared_v1';
const NAMES_KEY = 'water_log_names_v1';
const VENUES_KEY = 'water_log_venues_v1';
let selectedVenue = '';

const SEED = { gary: [], joyce: [] };

var data;
data = load();

// ── 玩家名稱（可自訂） ──
var names = loadNames();
function loadNames() {
  try {
    const raw = localStorage.getItem(NAMES_KEY);
    if (raw) { const n = JSON.parse(raw); if (n && n.a && n.b) return n; }
  } catch(e){}
  return null; // null 代表還沒設定，會跳出設定畫面
}
function saveNames(a, b) {
  names = { a: a, b: b };
  try { localStorage.setItem(NAMES_KEY, JSON.stringify(names)); } catch(e){}
}
function nameA(){ return names ? names.a : '玩家一'; }
function nameB(){ return names ? names.b : '玩家二'; }

function load() {
  // 網址帶 ?reset 時，強制清掉舊存檔、重新灌入完整資料
  try {
    if (location.search.indexOf('reset') !== -1) {
      const fresh = JSON.parse(JSON.stringify(SEED));
      localStorage.setItem(STORAGE_KEY, JSON.stringify(fresh));
      // 防呆：執行一次後把 reset 從網址移除，避免加入主畫面後每次開啟都洗掉資料
      try { history.replaceState(null, '', location.pathname); } catch(_){}
      return fresh;
    }
  } catch(e){}
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    // 只有當存檔「真的有記錄」時才採用；空的或壞的就重灌
    if (raw) {
      const p = JSON.parse(raw);
      if (p && Array.isArray(p.gary) && Array.isArray(p.joyce)) return p;
    }
  } catch(e){}
  // 首次使用或存檔是空的 → 灌入舊資料並存檔
  const init = JSON.parse(JSON.stringify(SEED));
  save(init);
  return init;
}
function save(d) {
  data = d;
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(d)); }
  catch(e){ try { toast('儲存失敗，請改用備份功能', false); } catch(_){} }
}

const fmt = n => n===null||n===undefined ? '—' : n===0 ? '0' : (n>0?'+':'−')+Math.abs(n).toLocaleString();
const fmtDate = d => { const [,m,day]=d.split('-'); return parseInt(m)+'/'+parseInt(day); };
const color = n => n===0 ? 'var(--stone)' : n>0 ? 'var(--win)' : 'var(--lose)';
const sum = a => a.reduce((s,r)=>s+r.amount,0);
const yearOf = d => d.slice(0,4);

// 目前選的年份（預設為資料中最新的一年）
var currentYear = (function(){
  const ys = [...data.gary, ...data.joyce].map(r=>yearOf(r.date));
  return ys.length ? ys.sort().slice(-1)[0] : String(new Date().getFullYear());
})();

// 取得所有有資料的年份（由新到舊）
function allYears() {
  const ys = [...new Set([...data.gary, ...data.joyce].map(r=>yearOf(r.date)))];
  const thisY = String(new Date().getFullYear());
  if (!ys.includes(thisY)) ys.push(thisY);
  return ys.sort().reverse();
}

// 只取目前年份的記錄
function yearData() {
  return {
    gary: data.gary.filter(r=>yearOf(r.date)===currentYear),
    joyce: data.joyce.filter(r=>yearOf(r.date)===currentYear),
  };
}

function renderYearTabs() {
  const tabs = allYears();
  document.getElementById('yearTabs').innerHTML = tabs.map(y=>
    `<button class="ytab ${y===currentYear?'on':''}" onclick="switchYear('${y}')">${y} 年</button>`
  ).join('');
}
function switchYear(y){ currentYear = y; render(); }

function render() {
  const d = yearData();
  document.getElementById('appdate').textContent = currentYear + ' · Annual Log';
  const la = document.getElementById('lblA'), lb = document.getElementById('lblB');
  if (la) la.textContent = nameA();
  if (lb) lb.textContent = nameB();
  const st = document.getElementById('subtitle');
  if (st && names) st.textContent = 'A record of fortune & misfortune · ' + nameA() + ' & ' + nameB();
  renderYearTabs();

  // 場次：各自算自己打了幾場（同一天同地點算一場）；合計為總場次
  const garySess = new Set(d.gary.map(r=>r.date+'__'+r.venue)).size;
  const joyceSess = new Set(d.joyce.map(r=>r.date+'__'+r.venue)).size;
  const totalSess = new Set([...d.gary, ...d.joyce].map(r=>r.date+'__'+r.venue)).size;

  const gT = sum(d.gary), jT = sum(d.joyce), cT = gT+jT;
  const cardDefs = [
    {lbl:nameA(), sub:'PLAYER 1', t:gT, c:garySess, feat:false},
    {lbl:nameB(), sub:'PLAYER 2', t:jT, c:joyceSess, feat:false},
    {lbl:'合計', sub:'Combined', t:cT, c:totalSess, feat:true},
  ];
  document.getElementById('cards').innerHTML = cardDefs.map((c,i)=>{
    const pos = c.t>=0;
    const bg = c.feat ? 'var(--ink)' : 'rgba(255,255,255,0.7)';
    const tMain = c.feat ? '#faf7f2' : 'var(--ink)';
    const tSub = c.feat ? 'var(--stone-l)' : 'var(--stone)';
    const ac = pos ? (c.feat?'var(--win-d)':'var(--win)') : (c.feat?'var(--lose-d)':'var(--lose)');
    return `<div class="scard card-sh fu" style="background:${bg};animation-delay:${.15+i*.07}s">
      <div class="lbl" style="color:${tMain}">${c.lbl}</div>
      <div class="sub" style="color:${tSub}">${c.sub}</div>
      <span class="amt num" style="color:${ac}">${fmt(c.t)}</span>
      <div class="cnt" style="color:${tSub}">${c.c} 場牌局</div>
    </div>`;
  }).join('');

  renderRecords();
  try { drawChart(); } catch(e) { /* 走勢圖出錯也不影響其他內容 */ }
}

// HTML 跳脫，避免地點名稱含特殊字元時破壞畫面
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

function renderRecords() {
  const d = yearData();
  const groups = {};
  // 同人同日同地點若有多筆，金額累加合併顯示（與總計一致）
  d.gary.forEach(r=>{ const k=r.date+'__'+r.venue; const g=(groups[k]=groups[k]||{date:r.date,venue:r.venue,gary:null,joyce:null}); g.gary=(g.gary??0)+r.amount; });
  d.joyce.forEach(r=>{ const k=r.date+'__'+r.venue; const g=(groups[k]=groups[k]||{date:r.date,venue:r.venue,gary:null,joyce:null}); g.joyce=(g.joyce??0)+r.amount; });
  const list = Object.values(groups).sort((a,b)=>b.date.localeCompare(a.date));

  document.getElementById('sessCount').textContent = list.length + ' 場';

  if (!list.length) { document.getElementById('records').innerHTML = '<div class="empty">這一年還沒有記錄</div>'; return; }

  document.getElementById('records').innerHTML = list.map(row=>{
    const ds = (row.gary??0)+(row.joyce??0);
    const personRow = (name, amt, key) => `
      <div class="prow">
        <span class="name">${esc(name)}</span>
        <span>${amt!==null
          ? `<span class="val num" style="color:${color(amt)}">${fmt(amt)}</span>
             <button class="dbtn" onclick="del('${key}','${row.date}',decodeURIComponent('${encodeURIComponent(row.venue)}'))">
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
             </button>`
          : `<span class="none">未記錄</span>`}</span>
      </div>`;
    return `<div class="sess">
      <div class="sess-top">
        <div><span class="sess-date num">${fmtDate(row.date)}</span><span class="sess-venue">${esc(row.venue)}</span></div>
        <div><span class="sess-sum-lbl">合計</span><span class="sess-sum num" style="color:${color(ds)}">${fmt(ds)}</span></div>
      </div>
      ${personRow(nameA(), row.gary, 'gary')}
      ${personRow(nameB(), row.joyce, 'joyce')}
    </div>`;
  }).join('');
}

function drawChart() {
  const svg = document.getElementById('chart');
  const dd = yearData();
  const dates = [...new Set([...dd.gary.map(r=>r.date),...dd.joyce.map(r=>r.date)])].sort();
  if (!dates.length) { svg.innerHTML=''; return; }
  let g=0,j=0;
  const pts = dates.map(d=>{
    g += dd.gary.filter(r=>r.date===d).reduce((s,r)=>s+r.amount,0);
    j += dd.joyce.filter(r=>r.date===d).reduce((s,r)=>s+r.amount,0);
    return {d, g, j, c:g+j};
  });

  const W = svg.clientWidth || 680, H = 220, P = {t:14,r:10,b:22,l:38};
  const all = pts.flatMap(p=>[p.g,p.j,p.c]).concat(0);
  let min = Math.min(...all), max = Math.max(...all);
  if (min===max){min-=1000;max+=1000;}
  const pad = (max-min)*0.1; min-=pad; max+=pad;
  const X = i => P.l + i*(W-P.l-P.r)/Math.max(1,pts.length-1);
  const Y = v => P.t + (max-v)/(max-min)*(H-P.t-P.b);

  const line = (key,stroke,dash) => {
    const dd = pts.map((p,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Y(p[key]).toFixed(1)).join(' ');
    return `<path d="${dd}" fill="none" stroke="${stroke}" stroke-width="2" ${dash?`stroke-dasharray="${dash}"`:''} stroke-linejoin="round"/>`;
  };
  const dots = (key,fill) => pts.map((p,i)=>`<circle cx="${X(i).toFixed(1)}" cy="${Y(p[key]).toFixed(1)}" r="2.5" fill="${fill}"/>`).join('');

  // x labels (稀疏)
  const step = Math.ceil(pts.length/6);
  const xl = pts.map((p,i)=> i%step===0 ? `<text x="${X(i)}" y="${H-6}" font-size="10" fill="#7a6850" text-anchor="middle" font-family="JetBrains Mono">${fmtDate(p.d)}</text>` : '').join('');
  // y zero line
  const zeroY = Y(0);
  const yLabels = [max, (max+min)/2, min].map(v=>`<text x="${P.l-6}" y="${Y(v)+3}" font-size="9" fill="#7a6850" text-anchor="end" font-family="JetBrains Mono">${v>0?'+':v<0?'−':''}${Math.abs(Math.round(v/1000))}k</text>`).join('');

  svg.setAttribute('viewBox',`0 0 ${W} ${H}`);
  svg.innerHTML = `
    <line x1="${P.l}" y1="${zeroY}" x2="${W-P.r}" y2="${zeroY}" stroke="#8b6f4a" stroke-width="1"/>
    ${yLabels}${xl}
    ${line('g','#3a5a7a')}${line('j','#a0392c')}${line('c','#3a2e1f','4 3')}
    ${dots('g','#3a5a7a')}${dots('j','#a0392c')}
    <g font-family="Noto Serif TC" font-size="11">
      <rect x="${W-P.r-150}" y="6" width="9" height="9" fill="#3a5a7a"/><text x="${W-P.r-137}" y="14" fill="#57534e">${esc(nameA())}</text>
      <rect x="${W-P.r-95}" y="6" width="9" height="9" fill="#a0392c"/><text x="${W-P.r-82}" y="14" fill="#57534e">${esc(nameB())}</text>
      <rect x="${W-P.r-40}" y="6" width="9" height="9" fill="#3a2e1f"/><text x="${W-P.r-27}" y="14" fill="#57534e">合計</text>
    </g>`;
}

/* ── 表單 ── */
var wlState = { A: 'win', B: 'win' };
function setWL(person, val) {
  wlState[person] = val;
  const box = document.getElementById('wl' + person);
  box.querySelector('.win').classList.toggle('on', val === 'win');
  box.querySelector('.lose').classList.toggle('on', val === 'lose');
}
// 取得手機本地日期（修正時區問題：避免早上打開時日期變成昨天）
function todayLocal() {
  const n = new Date();
  return n.getFullYear() + '-' + String(n.getMonth()+1).padStart(2,'0') + '-' + String(n.getDate()).padStart(2,'0');
}
function openForm() {
  document.getElementById('fDate').value = todayLocal();
  document.getElementById('fGary').value = '';
  document.getElementById('fJoyce').value = '';
  document.getElementById('fCustom').value = '';
  setWL('A','win'); setWL('B','win');
  selectedVenue = '';
  renderVenues();
  document.getElementById('overlay').classList.add('show');
}
function closeForm() { document.getElementById('overlay').classList.remove('show'); }
// 從所有記錄中收集用過的地點（依使用次數排序，最常去的排前面）
function usedVenues() {
  const count = {};
  [...data.gary, ...data.joyce].forEach(r=>{
    if (r.venue && r.venue !== '未指定') count[r.venue] = (count[r.venue]||0) + 1;
  });
  return Object.keys(count).sort((a,b)=>count[b]-count[a]).slice(0, 8);
}

function renderVenues() {
  const list = usedVenues();
  const box = document.getElementById('venues');
  if (!list.length) {
    box.innerHTML = '<div class="venue-empty">直接在下面輸入地點，用過的會自動變成快捷鍵</div>';
  } else {
    box.innerHTML = list.map(v=>
      `<button class="vbtn ${v===selectedVenue?'on':''}" onclick="pickVenue(decodeURIComponent('${encodeURIComponent(v)}'))">${esc(v)}</button>`).join('');
  }
}
function pickVenue(v){
  // 再點一次可取消選取
  selectedVenue = (selectedVenue === v) ? '' : v;
  document.getElementById('fCustom').value = selectedVenue;
  renderVenues();
}

function addRecord() {
  const date = document.getElementById('fDate').value;
  let venue = document.getElementById('fCustom').value.trim() || selectedVenue || '未指定';
  if (!date) { alert('請選擇日期'); return; }
  const gs = document.getElementById('fGary').value;
  const js = document.getElementById('fJoyce').value;
  let ga = gs===''?null:Math.abs(Number(gs));
  let ja = js===''?null:Math.abs(Number(js));
  if (ga!==null && wlState.A==='lose') ga = -ga;
  if (ja!==null && wlState.B==='lose') ja = -ja;
  if (ga===null && ja===null) { alert('請至少填寫一個金額'); return; }

  const next = { gary:[...data.gary], joyce:[...data.joyce] };
  if (ga!==null && !isNaN(ga)) { next.gary.push({date,venue,amount:ga}); next.gary.sort((a,b)=>a.date.localeCompare(b.date)); }
  if (ja!==null && !isNaN(ja)) { next.joyce.push({date,venue,amount:ja}); next.joyce.sort((a,b)=>a.date.localeCompare(b.date)); }
  save(next);
  currentYear = yearOf(date);
  closeForm();
  render();
  toast('記錄已存好 ✓');
}

function del(person, date, venue) {
  if (!confirm('確定刪除這筆記錄？')) return;
  const arr = data[person];
  const next = {...data, [person]: arr.filter(r=>!(r.date===date && r.venue===venue))};
  if (next[person].length === arr.length) return;
  save(next);
  render();
  toast('已刪除');
}

/* ── 備份 / 還原 ── */
function exportData() {
  const blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = '水上日誌_備份_'+new Date().toISOString().slice(0,10)+'.json';
  a.click(); URL.revokeObjectURL(url);
  toast('備份已下載 📁');
}
function importData(e) {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const p = JSON.parse(ev.target.result);
      // 嚴格驗證：必須是陣列，且每筆都有正確的日期/地點/金額
      const okRec = r => r && typeof r.date==='string' && /^\d{4}-\d{2}-\d{2}$/.test(r.date)
                       && typeof r.venue==='string' && typeof r.amount==='number' && isFinite(r.amount);
      if (!Array.isArray(p.gary) || !Array.isArray(p.joyce)
          || !p.gary.every(okRec) || !p.joyce.every(okRec)) throw 0;
      save(p); render();
      toast('已還原 '+(p.gary.length+p.joyce.length)+' 筆記錄');
    } catch { toast('檔案格式錯誤', false); }
  };
  reader.readAsText(file);
  e.target.value = '';
}

let toastTimer;
function toast(msg, ok=true) {
  const t = document.getElementById('toast');
  if (!t) return;
  t.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="${ok?'#6ee7b7':'#fca5a5'}" stroke-width="2.2" width="15" height="15"><polyline points="20 6 9 17 4 12"/></svg> ${msg}`;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2600);
}

function doSetup() {
  const a = document.getElementById('setA').value.trim() || '玩家一';
  const b = document.getElementById('setB').value.trim() || '玩家二';
  saveNames(a, b);
  document.getElementById('setupOverlay').classList.remove('show');
  render();
}
// 之後想改名字
function editNames() {
  document.getElementById('setA').value = nameA();
  document.getElementById('setB').value = nameB();
  document.getElementById('setupOverlay').classList.add('show');
}

function boot() {
  if (!names) { document.getElementById('setupOverlay').classList.add('show'); }
  try { render(); }
  catch(e) {
    const rec = document.getElementById('records');
    if (rec) rec.innerHTML = '<div class="empty">載入時發生問題：' + (e && e.message ? e.message : e) + '</div>';
  }
}
window.addEventListener('resize', function(){ try { drawChart(); } catch(e){} });
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}
</script>
